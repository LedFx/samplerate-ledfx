{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>LedFx/renovate-config"
  ],
  "forkProcessing": "enabled",
  "customManagers": [
    {
      "customType": "regex",
      "description": "libsamplerate tracks master by commit (external/CMakeLists.txt): its last release, 0.2.2, is from 2021.",
      "managerFilePatterns": [
        "/^external/CMakeLists\\.txt$/"
      ],
      "matchStrings": [
        "set\\(LIBSAMPLERATE_COMMIT (?<currentDigest>[0-9a-f]{40})\\) # (?<currentValue>\\S+)"
      ],
      "depNameTemplate": "libsamplerate",
      "packageNameTemplate": "https://github.com/libsndfile/libsamplerate",
      "datasourceTemplate": "git-refs"
    },
    {
      "customType": "regex",
      "description": "Last-reviewed upstream fork commit. A bump PR means upstream moved: review it (see MAINTAINING.md).",
      "managerFilePatterns": [
        "/^MAINTAINING\\.md$/"
      ],
      "matchStrings": [
        "upstream: (?<packageName>https://github\\.com/\\S+) (?<currentValue>\\S+)@(?<currentDigest>[0-9a-f]{40})"
      ],
      "depNameTemplate": "upstream python-samplerate",
      "datasourceTemplate": "git-refs"
    }
  ],
  "packageRules": [
    {
      "description": "C/C++ deps change the compiled wheel, and upstream bumps need porting; a person reads these.",
      "matchManagers": [
        "custom.regex"
      ],
      "automerge": false
    },
    {
      "description": "pybind11 (a build requirement in pyproject.toml) is compiled into the wheel; a person reads these.",
      "matchPackageNames": [
        "pybind11"
      ],
      "automerge": false
    },
    {
      "description": "Branch commits (git-refs) carry no release timestamp; the preset's release-age wait would hold these forever.",
      "matchDepNames": [
        "upstream python-samplerate",
        "libsamplerate"
      ],
      "minimumReleaseAge": null
    }
  ]
}
